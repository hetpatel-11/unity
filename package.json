{
	"name": "unity-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1 --port 4317",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"dev:api": "tsx watch server/index.ts",
		"dev:all": "node scripts/dev.mjs",
