		"@fontsource-variable/inter": "^5.3.0",
		"@iconify/react": "^6.0.2",
		"@iconify/types": "^2.0.0",
		"@novnc/novnc": "^1.7.0",
		"@streamdown/code": "1.1.1",
		"@tanstack/react-query": "5.102.8",
		"@uiw/react-codemirror": "4.25.12",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"ai": "^7.0.131",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.3.0",
		"diff": "9.0.0",
		"eve": "0.73.0",
