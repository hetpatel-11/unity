{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["vite/client"],
		"paths": {
			"#/*": ["./src/*"],
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "vite.config.ts", "server", "agent"]
}
